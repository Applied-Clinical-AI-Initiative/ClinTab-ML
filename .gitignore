# ---------------------------------------------------------------------------
# patient data. the nsqip puf data use agreement forbids committing row level
# data, and real cohorts dropped into Data/ must never reach github either.
# ---------------------------------------------------------------------------
thktha_cohort.csv
y1_test_predictions.csv
*puf*.txt
*PUF*.txt
*puf*.csv
*PUF*.csv
*.sav
*.sas7bdat
*.dta
*.xpt
/Data/*
!/Data/README.md
!/Data/sample_clinical.csv

# ---------------------------------------------------------------------------
# clintab-ml runtime data: sessions, uploads, exports, trained models and the
# session cookie key (runtime/.secret_key)
# ---------------------------------------------------------------------------
/runtime/
/models/
*.pkl
*.joblib

# ---------------------------------------------------------------------------
# paper. paper/paper.md, paper.bib, figure_optimism.png and the scripts in
# paper/analysis/ ship. paper/analysis/results/ holds the outputs of the nsqip
# analysis and never goes to github, nor do the drafts and notes in paper/v2/.
# ---------------------------------------------------------------------------
/paper/v2/
/paper/analysis/results/

# local documents that are not part of the release
/*.pdf
/*.docx
/*.doc
/*.pptx
/*.xlsx
*.numbers
~$*
# maintainer notes: release steps, audit, guides. local only.
/internal-guides/
RELEASE_AUDIT.md

